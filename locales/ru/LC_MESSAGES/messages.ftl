start-message = 👋 <b>Привет! Я — EZChart</b>

    📸 Отправь мне <b>скриншот графика</b> (любой таймфрейм, любой инструмент), и я сделаю быстрый технический разбор.

    <b>Что я умею:</b>
    • Определять тренд и ключевые уровни
    • Рассчитывать примерный Risk/Reward
    • Объяснять логику простым языком

    ⚠️ <i>Я не даю финансовых советов. Это образовательный инструмент.</i>

help-message = 📸 <b>Как пользоваться:</b>
    1. Сделай скриншот графика из TradingView / MT4 / MT5 / любого приложения
    2. Отправь его сюда как фото
    3. Получи анализ через 5-10 секунд

    <b>Команды:</b>
    /start — начать
    /help — эта справка
    /language — сменить язык

    ⚠️ <i>Дисклеймер: не финансовая рекомендация.</i>

about-message = 📊 <b>EZChart</b> — Trading analysis made EZ.

    Скриншот → анализ за 5 секунд.

    🔧 <b>Стек:</b> aiogram 3.x + Gemini 3.6 Flash
    📦 <b>Open source:</b> https://github.com/1369777-svg/ezchart-bot

    Made with ❤️ for beginner traders.

analysis-in-progress = 🔍 <i>Анализирую график...</i>

error-unreadable = ❌ <b>Не удалось распознать график.</b>

    Попробуй:
    • Более чёткий скриншот
    • Обрезать лишние элементы интерфейса
    • Убедиться, что видны оси и свечи

error-ai-unavailable = ⚠️ <b>Ошибка при анализе.</b>

    Возможные причины:
    • Временная недоступность AI-модели
    • Превышен лимит бесплатных запросов

    Попробуй ещё раз через минуту.

error-generic = ⚠️ <b>Что-то пошло не так.</b> Попробуй позже.

throttled = ⏳ <b>Слишком быстро.</b> Подожди <b>{ $seconds } сек</b> перед следующим анализом.

send-photo-please = 📸 <b>Мне нужен именно скриншот графика.</b>

    Сделай скрин из TradingView или терминала и отправь как фото.

send-as-photo = 📸 Отправь график именно как <b>фото</b> (не файлом).

    В Telegram: прикрепи → выбери «Фото» или сделай скриншот.

language-prompt = 🌍 <b>Выберите язык / Choose language / Scegli la lingua:</b>

language-button-ru = 🇷🇺 Русский
language-button-en = 🇬🇧 English
language-button-it = 🇮🇹 Italiano

language-changed = ✅ Язык изменён на <b>Русский</b>